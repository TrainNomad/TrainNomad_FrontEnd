# Copiez ce fichier en `.env` (ou `.env.local` pour une configuration propre à votre machine).
# Attention : `.env.local` est aussi lu par `pnpm build`.

# URL des API (Go) : choisies automatiquement selon l'adresse du site.
#   Site ouvert sur localhost -> API locales : Europe :8000, guides :8001, TGVmax :8002 (python run_local.py)
#   Site en ligne             -> API Render  : trainnomad-go, trainnomad-guide, trainnomad-tgvmax-api
# Pour forcer une URL (ex. front local + API Render), décommentez la ligne voulue, sans « / » final :
# VITE_API_URL=https://trainnomad-go.onrender.com
# VITE_GUIDES_API_URL=https://trainnomad-guide.onrender.com
# VITE_TGVMAX_API_URL=https://trainnomad-tgvmax-api.onrender.com

# Clé MapTiler pour le fond de carte de l'explorateur.
VITE_MAPTILER_KEY=

# Nombre maximal de correspondances pour la carte d'exploration (0 = directs uniquement).
VITE_EXPLORER_MAX_TRANSFERS=1
