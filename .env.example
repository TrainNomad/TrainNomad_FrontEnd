# Copiez ce fichier en `.env` (ou `.env.local` pour une configuration propre à votre machine).
# Attention : `.env.local` est aussi lu par `pnpm build`.

# URL des API (Go) : choisies automatiquement selon l'adresse du site.
#   Site ouvert sur localhost -> API locales : Europe :8000, guides :8001, TGVmax :8002 (python run_local.py)
#   Site en ligne             -> API du serveur : api, guides-api et tgvmax-api.trainnomad.eu
# Pour forcer une URL (ex. front local + API en ligne), décommentez la ligne voulue, sans « / » final :
# VITE_API_URL=https://api.trainnomad.eu
# VITE_GUIDES_API_URL=https://guides-api.trainnomad.eu
# VITE_TGVMAX_API_URL=https://tgvmax-api.trainnomad.eu

# Clé MapTiler pour le fond de carte de l'explorateur.
VITE_MAPTILER_KEY=

# Mesure d'audience Umami (sans cookie) : l'identifiant du site est dans src/config.ts et seul le
# domaine trainnomad.eu est compté. Pour utiliser un autre site Umami ou un Umami auto-hébergé :
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SCRIPT_URL=https://stats.trainnomad.eu/script.js

# Nombre maximal de correspondances pour la carte d'exploration (0 = directs uniquement).
VITE_EXPLORER_MAX_TRANSFERS=2
