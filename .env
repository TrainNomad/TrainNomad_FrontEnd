# ─── Configuration TrainNomad (front) ─────────────────────────────────────────
# Modifiez ces valeurs puis relancez `pnpm dev` / refaites `pnpm build`.
# Toutes les variables lues par le navigateur doivent commencer par VITE_.

# URL de l'API de routage (service Go sur Render), sans « / » final.
VITE_API_URL=https://trainnomad-go.onrender.com

# Clé MapTiler pour le fond de carte de l'explorateur.
VITE_MAPTILER_KEY=sBZIT01ONEm9wMymYCwd

# Nombre maximal de correspondances pour la carte d'exploration (0 = directs uniquement).
VITE_EXPLORER_MAX_TRANSFERS=1
